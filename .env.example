# Copy this file to .env.local and fill in your key.
# .env.local is ignored by git, so your key never reaches GitHub.
# Create a key at https://console.anthropic.com (API Keys).
ANTHROPIC_API_KEY=

# The privacy scrubber (npm run scrubber). Only change this if you run it somewhere else.
# SCRUBBER_URL=http://127.0.0.1:5002
