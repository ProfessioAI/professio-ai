{
  "name": "professio-ai",
  "version": "0.10.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:samples": "node scripts/check-samples.mjs && node scripts/check-samples.mjs samples/prior-year",
    "grade": "node scripts/grade.mjs",
    "release": "node scripts/release.mjs",
    "grade:if-needed": "node scripts/grade-if-needed.mjs",
    "scrubber": "services/scrubber/.venv/bin/python -m uvicorn server:app --host 127.0.0.1 --port 5002 --app-dir services/scrubber",
    "scrubber:setup": "/usr/local/bin/python3.12 -m venv services/scrubber/.venv && services/scrubber/.venv/bin/pip install -r services/scrubber/requirements.txt && services/scrubber/.venv/bin/python -m spacy download en_core_web_sm",
    "scrub:test": "node scripts/scrub-test.mjs",
    "skills:test": "node scripts/skills-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
